# ============================================================
# .env.example — LectureLive 完整环境变量配置
# 复制为 .env.local 后填入实际值
# ============================================================

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3001
NODE_ENV=development
# 撤销分享链接时 Web 进程通知 WS 进程驱逐已连接观众的内部地址。
# 默认 http://127.0.0.1:${WS_PORT:-3001}，仅当 WS 与 Web 进程不同机部署时需设置
# LIVE_SHARE_WS_INTERNAL_URL=http://127.0.0.1:3001

# === Auth ===
# 生产环境请使用: openssl rand -hex 32 生成强随机密钥
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
ENCRYPTION_KEY=change-me-to-a-different-strong-random-secret-min-32-chars
# 密钥轮换时可临时保留旧值，运行 npm run security:reencrypt-llm-keys 后再删除
# ENCRYPTION_KEY_PREVIOUS=old-encryption-key-for-rotation-only

# === Database (MySQL) ===
# 本地开发:
DATABASE_URL=mysql://lecturelive:your_password@localhost:3306/lecturelive
# 启动应用时自动执行 prisma db push，同步表结构到 MySQL
# 设为 false 可关闭自动建表
AUTO_DB_PUSH=true
# === Docker Compose 部署密码（在 .env 文件中设置） ===
# DB_PASSWORD=<使用 openssl rand -base64 24 生成>
# DB_PASSWORD_ENCODED=<同上但 URL 编码特殊字符>
# MYSQL_ROOT_PASSWORD=<使用 openssl rand -base64 24 生成>

# === Redis ===
# 本地开发:
REDIS_URL=redis://localhost:6379
# Docker Compose 部署（带密码）:
# REDIS_URL=redis://:your_redis_password@redis:6379
# REDIS_PASSWORD=<使用 openssl rand -base64 24 生成>          # redis 服务鉴权用（未编码原值）
# REDIS_PASSWORD_ENCODED=<同上但 URL 编码特殊字符>            # 拼进 REDIS_URL 用（含 '/' '@' ':' 时必须编码）

# === Soniox ASR ===
# Soniox API Key 推荐通过管理界面写入数据库（加密存储）
# 环境变量仅作为 fallback，优先级高于数据库：
# SONIOX_API_KEY=your_soniox_api_key
# SONIOX_US_API_KEY=your_us_key
# SONIOX_EU_API_KEY=your_eu_key
# SONIOX_JP_API_KEY=your_jp_key
SONIOX_DEFAULT_REGION=eu

# === Cloudreve V4 OAuth Storage ===
# 在 Cloudreve V4 管理面板中创建 OAuth 应用后获取以下凭据
# CLOUDREVE_BASE_URL=https://cloud.example.com
# CLOUDREVE_CLIENT_ID=your_oauth_client_id
# CLOUDREVE_CLIENT_SECRET=your_oauth_client_secret
# 允许连接到内网地址（开发环境使用）
# CLOUDREVE_ALLOW_PRIVATE_HOST=true

# === LLM Provider Configuration ===
# LLM 配置推荐通过管理界面写入数据库（API Key 加密存储）
# 以下仅作为数据库不可用时的 fallback：
# LLM_ACTIVE_PROVIDER=claude
# LLM_PROVIDERS_CLAUDE_NAME=claude
# LLM_PROVIDERS_CLAUDE_DISPLAY_NAME=Claude Sonnet
# LLM_PROVIDERS_CLAUDE_API_BASE=https://api.anthropic.com
# LLM_PROVIDERS_CLAUDE_API_KEY=sk-ant-xxxxx
# LLM_PROVIDERS_CLAUDE_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDERS_CLAUDE_THINKING_BUDGET=0
# LLM_PROVIDERS_CLAUDE_MAX_TOKENS=4096
# LLM_PROVIDERS_CLAUDE_TEMPERATURE=0.3
# LLM_PROVIDERS_CLAUDE_IS_ANTHROPIC=true

# === Keyword Weights (可选) ===
# KEYWORD_WEIGHT_FOLDER=0.4
# KEYWORD_WEIGHT_SESSION_LLM=0.3
# KEYWORD_WEIGHT_UPLOADED_FILE=0.3

# === Proxy / IP ===
# 【生产强烈建议 true】本项目的标准部署形态就是 nginx 反代（见 deploy/nginx-lecturelive.conf，
# 已写好 X-Real-IP $remote_addr 与 X-Forwarded-For $proxy_add_x_forwarded_for）。
# 设为 true 后限流/审计/登录提醒才能拿到真实客户端 IP。
#
# 保持 false 的代价（H7）：拿不到 IP 时登录/注册的 IP 桶会整段跳过
#   （只剩 email 维度，拦不住“一个弱口令遍历海量邮箱”的横向密码喷洒），
#   通用限流也只能退到“登录用户 / 请求路径”维度分桶（见 src/lib/rateLimit.ts）。
# 设为 true 的前提：应用端口（3000/3001）**不得**直接对公网开放，
#   否则攻击者直连并伪造该头即可逃逸限流。
TRUSTED_PROXY=true

# （可选）钉死取客户端 IP 的头：auto（默认，X-Real-IP 优先、回退 XFF 末段）/
# x-real-ip / x-forwarded-for。反代只设了其中一个头时必须钉死（M22）：
# 否则另一个头完全由客户端控制，每次换一个值就是一个全新的限流桶。
# 两个头取值不一致时服务端会打一次 warn 提醒。
# TRUSTED_PROXY_IP_HEADER=auto

# （可选）Redis 不可用时的限流姿态：缺省 fail-open（退到进程内内存计数，
# 多实例下实际限额 = 配置 × 实例数）；置 1 改为 fail-closed（Redis 挂即 429）。
# RATE_LIMIT_FAIL_CLOSED=0

# === Default Language ===
NEXT_PUBLIC_DEFAULT_SOURCE_LANG=en
NEXT_PUBLIC_DEFAULT_TARGET_LANG=zh

# === 充值系统（Recharge System） ===
# 充值/支付渠道（支付宝 / 微信 / Stripe / 沙箱）的开关与凭据均在 **管理后台 → 充值** 里配置，
# 加密存于 SiteSetting，无需在此设置环境变量。
# 前提：站点 URL（Admin → 站点设置 site_url）需为可被支付网关回调到达的公网地址，
# 回调地址形如 {site_url}/api/wallet/callback/{alipay|wechat|stripe}。
# 沙箱渠道（recharge_sandbox_enabled）仅供本地/测试联调，生产环境务必关闭。

# === 邮件系统（Email） ===
# SMTP 发信、邮箱验证、发件人、一次性邮箱拦截、教育邮箱白名单、营销总开关等，
# 均在 **管理后台 → 设置（注册 / 邮件）** 里配置，SMTP 密码加密存于 SiteSetting，无需环境变量。
# 邮箱验证「硬门禁」需先配好并测试 SMTP 才会生效（否则新用户按已验证放行，避免锁死注册）。
# 站点 URL（site_url）用于拼验证/重置/退订链接，需为用户可访问的地址。
#
# 本地开发/测试可开启「捕获模式」：邮件不真正外发，改写入内存 outbox（供联调查看验证/重置链接）。
# 仅在非生产环境 + 显式开启时生效，生产恒关闭。
# EMAIL_CAPTURE_MODE=1

# === 首次部署引导（Setup bootstrap，P6-4）===
# /api/setup 在「还没有任何管理员」的窗口里是公开可达的：未认证请求可以创建第一个管理员、
# 把 LLM/Soniox 地址指向任意主机（转录与用户 prompt 会持续发往那里）、并置位 setup_complete。
# 设置本变量后，该窗口关闭 —— 每个 /api/setup 请求都必须带 `x-setup-token: <值>`
#（已存在管理员时，管理员会话是等价的第二把钥匙，故本 token 永远锁不死正常管理员）。
#
# ⚠️ 在**全新库**上设置它，浏览器 /setup 向导会 401（页面不带这个头），此时只能用 curl 完成引导，
# 具体命令见 deploy/INSTALL.md。公网部署建议设置；纯内网/本机开发可留空。
# SETUP_BOOTSTRAP_TOKEN=
