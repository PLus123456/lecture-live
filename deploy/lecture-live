#!/usr/bin/env bash
# ============================================================
# LectureLive 一键管理脚本
# 安装后可直接在终端输入 lecture-live 使用
# ============================================================
set -euo pipefail

VERSION="1.0.0"
APP_DIR="/opt/lecturelive"
SRC_DIR="/opt/lecturelive/src"
BACKUP_DIR="/opt/lecturelive/backups"
REPO_URL="https://github.com/PLus123456/lecture-live.git"
WEB_SERVICE="lecturelive-web"
WS_SERVICE="lecturelive-ws"
WEB_PORT=3000
WS_PORT=3001

# ── 颜色定义 ──
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── 工具函数 ──
info()  { echo -e "${GREEN}[✓]${NC} $*"; }
warn()  { echo -e "${YELLOW}[!]${NC} $*"; }
error() { echo -e "${RED}[✗]${NC} $*"; }
fatal() { error "$*"; exit 1; }
step()  { echo -e "${CYAN}[→]${NC} $*"; }

need_root() {
    [[ $EUID -eq 0 ]] || fatal "此操作需要 root 权限，请使用: sudo lecture-live $*"
}

# systemd unit 自身也有 ExecStartPre；这里再检查一次，覆盖从旧版升级过程中仍装着旧 unit、
# 或回滚到旧运行产物的迁移窗口。失败时主动隔离任何仍在运行的旧服务。
assert_payment_startup_preflight() {
    local script="$APP_DIR/scripts/check-production-payment-config.mjs"
    systemctl stop "$WEB_SERVICE" 2>/dev/null || true
    systemctl stop "$WS_SERVICE" 2>/dev/null || true
    if systemctl is-active --quiet "$WEB_SERVICE" || systemctl is-active --quiet "$WS_SERVICE"; then
        fatal "无法确认旧服务已停止；拒绝进入生产启动检查"
    fi
    if [[ ! -f "$script" ]] || \
       ! runuser -u lecturelive -- /usr/bin/node --env-file="$APP_DIR/.env" "$script"; then
        fatal "生产支付配置未通过启动安全检查；服务已保持停止"
    fi
    if [[ ! -f "$APP_DIR/.runtime-security-version" ]] || \
       ! grep -Fxq 'health-ready-v1' "$APP_DIR/.runtime-security-version"; then
        fatal "运行产物早于受保护 readiness 路由；服务已保持停止，请升级到安全版本"
    fi
}

quarantine_failed_start() {
    systemctl stop "$WEB_SERVICE" 2>/dev/null || true
    systemctl stop "$WS_SERVICE" 2>/dev/null || true
    if systemctl is-active --quiet "$WEB_SERVICE" || systemctl is-active --quiet "$WS_SERVICE"; then
        fatal "启动检查失败，且无法确认失败实例已停止"
    fi
    fatal "$1；所有服务已保持停止"
}

require_deep_readiness() {
    if ! runuser -u lecturelive -- /usr/bin/node --env-file="$APP_DIR/.env" \
        "$APP_DIR/scripts/check-readiness.mjs" --wait >/dev/null 2>&1; then
        quarantine_failed_start "深度就绪检查失败"
    fi
}

# ── 以 root 执行源码检出里的东西之前的所有权检查 ──
# update / install / rollback 会以 root 在源码检出里跑 git、npm ci、next build 与 deploy/*.sh，所以
# 只认只有 root 能改的检出：路径上每一级目录与要执行的整棵目录树都归 root，且没有组/其他写权限。
# 只看脚本文件本身不够：改名/替换条目只看父目录的写权限，能写 /opt/lecturelive 就能把整个 src 换掉；
# git 也会执行 .git 里的 hooks 与配置。带粘滞位的上级目录（如 /tmp）例外：别人改不了不归自己的条目。
# 归属写成「root 或当前用户」：CLI 总以 root 运行，二者是一回事（sshd StrictModes 也是这个口径），
# 契约测试则靠它以普通用户运行。
#
# 打印 $1（解析过软链的绝对路径，最后一级可以尚不存在）以上每一级目录与 $1 整棵子树里第一个
# 不满足要求的条目；全部满足时什么都不打印。
first_writable_by_others() {
    local path="$1" dir="$1" hit
    # 查的必须就是随后要用的：不接受相对路径或软链
    if [[ "$path" != /* || -L "$path" ]]; then
        printf '%s\n' "$path"
        return 0
    fi
    while [[ "$dir" != / ]]; do
        dir="$(dirname "$dir")"
        hit="$(find "$dir" -maxdepth 0 \( ! \( -uid 0 -o -uid "$EUID" \) \
            -o \( -perm -020 -o -perm -002 \) ! -perm -1000 \) -print)" || hit="$dir"
        if [[ -n "$hit" ]]; then
            printf '%s\n' "$hit"
            return 0
        fi
    done
    [[ -e "$path" ]] || return 0
    # 软链自身的权限位恒为 777，不算数；它归谁照样要查
    hit="$(find "$path" \( ! \( -uid 0 -o -uid "$EUID" \) \
        -o ! -type l \( -perm -020 -o -perm -002 \) \) -print -quit)" || hit="$path"
    if [[ -n "$hit" ]]; then
        printf '%s\n' "$hit"
    fi
}

# 以 root 执行 $1（解析过软链的路径）里的东西之前调用，$2 说明要拿它做什么。
# 不满足 first_writable_by_others 的要求就报出第一个问题条目并退出，什么都不改。
require_root_only() {
    local hit
    hit="$(first_writable_by_others "$1")"
    [[ -n "$hit" ]] || return 0
    error "$2，但 $1 不是只有 root 能改："
    echo "      $(ls -ld "$hit" 2>/dev/null || printf '%s' "$hit")"
    warn "已拒绝，未做任何改动。早于此版本的 setup/install/upgrade/rollback 会把整个 $APP_DIR（含 src、backups、.env）"
    warn "交给服务用户：确认没被改过后按 deploy/INSTALL.md「源码检出与备份的所有权」收回，拿不准就重新克隆。"
    exit 1
}

# ── 分隔线 ──
divider() {
    echo -e "${DIM}────────────────────────────────────────${NC}"
}

# ── 获取服务状态（带颜色） ──
service_status_text() {
    local svc=$1
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        echo -e "${GREEN}运行中${NC}"
    elif systemctl is-enabled --quiet "$svc" 2>/dev/null; then
        echo -e "${YELLOW}已停止${NC}"
    else
        echo -e "${DIM}未安装${NC}"
    fi
}

# ── 获取服务运行时间 ──
service_uptime() {
    local svc=$1
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        local ts
        ts=$(systemctl show "$svc" --property=ActiveEnterTimestamp --value 2>/dev/null)
        if [[ -n "$ts" ]]; then
            local start_epoch now_epoch diff
            start_epoch=$(date -d "$ts" +%s 2>/dev/null) || return
            now_epoch=$(date +%s)
            diff=$((now_epoch - start_epoch))
            local days=$((diff / 86400))
            local hours=$(( (diff % 86400) / 3600 ))
            local mins=$(( (diff % 3600) / 60 ))
            if [[ $days -gt 0 ]]; then
                echo "${days}天${hours}时${mins}分"
            elif [[ $hours -gt 0 ]]; then
                echo "${hours}时${mins}分"
            else
                echo "${mins}分钟"
            fi
        fi
    fi
}

# ── 获取服务内存占用 ──
service_memory() {
    local svc=$1
    local pid
    pid=$(systemctl show "$svc" --property=MainPID --value 2>/dev/null)
    if [[ -n "$pid" && "$pid" != "0" ]]; then
        local rss
        rss=$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ')
        if [[ -n "$rss" ]]; then
            echo "$((rss / 1024))MB"
        fi
    fi
}

# ══════════════════════════════════════════
#  命令实现
# ══════════════════════════════════════════

cmd_start() {
    need_root start
    assert_payment_startup_preflight
    step "启动 LectureLive 服务..."
    if ! systemctl start "$WEB_SERVICE" "$WS_SERVICE"; then
        quarantine_failed_start "服务启动失败"
    fi
    sleep 2
    # 检查启动结果
    local web_ok=false ws_ok=false
    systemctl is-active --quiet "$WEB_SERVICE" && web_ok=true
    systemctl is-active --quiet "$WS_SERVICE" && ws_ok=true
    if $web_ok && $ws_ok; then
        require_deep_readiness
        info "所有服务已启动"
    else
        $web_ok || error "Web 服务启动失败"
        $ws_ok  || error "WebSocket 服务启动失败"
        echo ""
        quarantine_failed_start "服务未全部进入 active 状态，请使用 lecture-live log 查看详细日志"
    fi
}

cmd_stop() {
    need_root stop
    step "停止 LectureLive 服务..."
    systemctl stop "$WEB_SERVICE" 2>/dev/null || true
    systemctl stop "$WS_SERVICE" 2>/dev/null || true
    info "所有服务已停止"
}

cmd_restart() {
    need_root restart
    assert_payment_startup_preflight
    step "重启 LectureLive 服务..."
    if ! systemctl restart "$WEB_SERVICE" "$WS_SERVICE"; then
        quarantine_failed_start "服务重启失败"
    fi
    sleep 2
    local web_ok=false ws_ok=false
    systemctl is-active --quiet "$WEB_SERVICE" && web_ok=true
    systemctl is-active --quiet "$WS_SERVICE" && ws_ok=true
    if $web_ok && $ws_ok; then
        require_deep_readiness
        info "所有服务已重启"
    else
        $web_ok || error "Web 服务重启失败"
        $ws_ok  || error "WebSocket 服务重启失败"
        quarantine_failed_start "服务未全部进入 active 状态，请使用 lecture-live log 查看详细日志"
    fi
}

cmd_status() {
    echo ""
    echo -e "${BOLD}  LectureLive 服务状态${NC}"
    divider

    # Web 服务
    local web_status ws_status
    web_status=$(service_status_text "$WEB_SERVICE")
    ws_status=$(service_status_text "$WS_SERVICE")
    local web_uptime ws_uptime web_mem ws_mem
    web_uptime=$(service_uptime "$WEB_SERVICE")
    ws_uptime=$(service_uptime "$WS_SERVICE")
    web_mem=$(service_memory "$WEB_SERVICE")
    ws_mem=$(service_memory "$WS_SERVICE")

    printf "  %-14s %b" "Web 服务:" "$web_status"
    [[ -n "$web_uptime" ]] && printf "  (运行 %s" "$web_uptime" && [[ -n "$web_mem" ]] && printf ", %s" "$web_mem"; printf ")"
    echo ""

    printf "  %-14s %b" "WebSocket:" "$ws_status"
    [[ -n "$ws_uptime" ]] && printf "  (运行 %s" "$ws_uptime" && [[ -n "$ws_mem" ]] && printf ", %s" "$ws_mem"; printf ")"
    echo ""

    divider

    # 端口监听检测
    local web_listen=false ws_listen=false
    ss -tlnp 2>/dev/null | grep -q ":${WEB_PORT} " && web_listen=true
    ss -tlnp 2>/dev/null | grep -q ":${WS_PORT} " && ws_listen=true

    printf "  %-14s" "端口监听:"
    $web_listen && echo -en " ${GREEN}:${WEB_PORT}${NC}" || echo -en " ${DIM}:${WEB_PORT}${NC}"
    $ws_listen  && echo -e  " ${GREEN}:${WS_PORT}${NC}" || echo -e  " ${DIM}:${WS_PORT}${NC}"

    # 健康检查
    printf "  %-14s" "健康检查:"
    if runuser -u lecturelive -- /usr/bin/node --env-file="$APP_DIR/.env" \
        "$APP_DIR/scripts/check-readiness.mjs" >/dev/null 2>&1; then
        echo -e " ${GREEN}正常${NC}"
    else
        echo -e " ${RED}异常${NC}"
    fi

    # 磁盘使用
    if [[ -d "$APP_DIR" ]]; then
        local disk_usage
        disk_usage=$(du -sh "$APP_DIR" 2>/dev/null | cut -f1)
        printf "  %-14s %s\n" "磁盘占用:" "$disk_usage"
    fi

    # 备份数量
    if [[ -d "$BACKUP_DIR" ]]; then
        local backup_count
        backup_count=$(ls "$BACKUP_DIR"/app-*.tar.gz 2>/dev/null | wc -l)
        printf "  %-14s %s 个\n" "备份数量:" "$backup_count"
    fi

    divider
    echo ""
}

cmd_log() {
    local service="all"
    local lines=50
    local follow=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            web)    service="web"; shift ;;
            ws)     service="ws"; shift ;;
            -f)     follow=true; shift ;;
            -n)     lines="$2"; shift 2 ;;
            *)      shift ;;
        esac
    done

    local journal_args=(-n "$lines" --no-pager)
    $follow && journal_args+=(-f)

    case "$service" in
        web)
            echo -e "${BOLD}  Web 服务日志${NC}"
            divider
            journalctl -u "$WEB_SERVICE" "${journal_args[@]}"
            ;;
        ws)
            echo -e "${BOLD}  WebSocket 服务日志${NC}"
            divider
            journalctl -u "$WS_SERVICE" "${journal_args[@]}"
            ;;
        all)
            echo -e "${BOLD}  全部服务日志${NC}"
            divider
            journalctl -u "$WEB_SERVICE" -u "$WS_SERVICE" "${journal_args[@]}"
            ;;
    esac
}

cmd_update() {
    need_root update

    # 检测源码目录：托管检出 $SRC_DIR，其次 root 自己的 /root/lecture-live。找到的检出会以 root 跑
    # git pull 与其中的 deploy/upgrade.sh（npm ci、next build……），所以刻意不去 /home/*/lecture-live
    # 里找：任何本地用户都能在家目录建 lecture-live/.git + deploy/upgrade.sh，按字母序还可能排在管理员
    # 前面。源码放在家目录里的手工部署照 deploy/INSTALL.md 在源码目录执行 sudo bash deploy/upgrade.sh。
    local src="$SRC_DIR"
    if [[ ! -d "$src/.git" && -d /root/lecture-live/.git ]]; then
        src=/root/lecture-live
    fi
    [[ -d "$src/.git" ]] || fatal "未找到源码目录，请先使用 lecture-live install 安装（手工部署请在源码目录执行: sudo bash deploy/upgrade.sh）"
    # 之后一律用解析软链后的真实路径：查过的就是要执行的
    src="$(readlink -f "$src")"
    require_root_only "$src" "update 要以 root 在 $src 里执行 git pull 与 deploy/upgrade.sh"

    echo ""
    echo -e "${BOLD}  LectureLive 更新${NC}"
    divider

    step "拉取最新代码..."
    (cd "$src" && git pull --ff-only)

    step "执行升级流程..."
    bash "$src/deploy/upgrade.sh"
}

cmd_install() {
    need_root install

    echo ""
    echo -e "${BOLD}  LectureLive 安装${NC}"
    divider

    # 检查依赖
    for cmd in node npm git; do
        if ! command -v "$cmd" &>/dev/null; then
            fatal "缺少必要工具: $cmd，请先安装"
        fi
    done
    info "依赖检查通过"

    # 克隆源码。检出随后要以 root 编译、执行（npm ci、next build、deploy/*.sh），所以它与路径上每一级
    # 目录都必须只有 root 能改；之后一律用解析软链后的真实路径，查过的就是要执行的。
    mkdir -p "$APP_DIR"
    if [[ ! -d "$SRC_DIR" ]]; then
        SRC_DIR="$(readlink -f "$APP_DIR")/src"
        require_root_only "$SRC_DIR" "install 要把源码克隆到 $SRC_DIR 并以 root 编译、执行"
        step "克隆仓库..."
        git clone "$REPO_URL" "$SRC_DIR"
    else
        SRC_DIR="$(readlink -f "$SRC_DIR")"
        require_root_only "$SRC_DIR" "install 要以 root 在 $SRC_DIR 里编译并执行部署脚本"
        step "源码目录已存在，拉取更新..."
        (cd "$SRC_DIR" && git pull --ff-only)
    fi

    # 安装依赖
    step "安装依赖..."
    (cd "$SRC_DIR" && npm ci)

    # 配置环境变量
    local env_needs_edit=false
    if [[ ! -f "$APP_DIR/.env" ]]; then
        if [[ -f "$SRC_DIR/.env.example" ]]; then
            cp "$SRC_DIR/.env.example" "$APP_DIR/.env"
            env_needs_edit=true
        elif [[ -f "$SRC_DIR/.env.local" ]]; then
            cp "$SRC_DIR/.env.local" "$APP_DIR/.env"
            warn "已从 .env.local 复制配置，请检查生产环境值"
        fi
    fi
    [[ -f "$APP_DIR/.env" ]] || fatal "未找到可用的环境配置模板"
    # 下面以 root 用 node --env-file 读它编译，而 node 会应用其中的 NODE_OPTIONS 等运行时选项：
    # 它也必须只有 root 能改（新装时刚从模板复制，归 root；重装时由 install/upgrade 收归 root）。
    require_root_only "$(readlink -f "$APP_DIR")/.env" "install 要以 root 用 node --env-file 读 $APP_DIR/.env"

    # 必须在首次复制模板后、任何提前 return 之前生成引导密钥并收紧权限。
    # 后续 deploy/install.sh 会幂等复核；这里保证等待管理员编辑期间也没有 0644 秘密文件。
    bash "$SRC_DIR/deploy/ensure-security-env.sh" "$APP_DIR/.env"

    if $env_needs_edit; then
        _install_self "$SRC_DIR"
        warn "已创建安全默认的 .env 配置文件，请编辑: $APP_DIR/.env"
        warn "编辑完成后运行: sudo lecture-live update"
        echo ""
        return
    fi

    # 编译 + 部署
    step "编译项目..."
    # next build 读运行时同一份 $APP_DIR/.env，口径与 deploy/upgrade.sh 相同（原因见那里的注释）
    (cd "$SRC_DIR" \
        && node --env-file="$APP_DIR/.env" scripts/run-prisma.mjs generate \
        && NODE_ENV=production node --env-file="$APP_DIR/.env" node_modules/.bin/next build \
        && npm run build:ws)

    step "部署服务..."
    bash "$SRC_DIR/deploy/install.sh"

    # 安装管理脚本自身
    _install_self "$SRC_DIR"

    echo ""
    info "安装完成！"
    echo ""
    echo "  使用 lecture-live 管理系统"
    echo "  Web:       http://127.0.0.1:${WEB_PORT}"
    echo "  WebSocket: http://127.0.0.1:${WS_PORT}"
    echo ""
}

cmd_uninstall() {
    need_root uninstall

    echo ""
    echo -e "${BOLD}${RED}  LectureLive 卸载${NC}"
    divider
    warn "此操作将停止服务并删除程序文件"
    warn "数据目录 $APP_DIR/data 和 .env 将被保留"
    echo ""
    read -rp "  确认卸载? 输入 YES 继续: " confirm
    [[ "$confirm" == "YES" ]] || { echo "  已取消"; exit 0; }
    echo ""

    step "停止服务..."
    systemctl stop "$WEB_SERVICE" 2>/dev/null || true
    systemctl stop "$WS_SERVICE" 2>/dev/null || true
    systemctl disable "$WEB_SERVICE" 2>/dev/null || true
    systemctl disable "$WS_SERVICE" 2>/dev/null || true

    step "移除 systemd 服务文件..."
    rm -f /etc/systemd/system/lecturelive-web.service
    rm -f /etc/systemd/system/lecturelive-ws.service
    systemctl daemon-reload

    step "清理程序文件（保留数据和配置）..."
    # 保留 data、.env、backups、src
    find "$APP_DIR" -mindepth 1 -maxdepth 1 \
        ! -name "data" ! -name ".env" ! -name "backups" ! -name "src" \
        -exec rm -rf {} +

    info "卸载完成"
    echo ""
    echo "  保留的内容:"
    echo "    数据:   $APP_DIR/data"
    echo "    配置:   $APP_DIR/.env"
    echo "    备份:   $APP_DIR/backups"
    echo "    源码:   $SRC_DIR"
    echo ""
    echo "  如需完全删除: sudo rm -rf $APP_DIR"
    echo "  如需删除管理命令: sudo rm /usr/local/bin/lecture-live"
    echo ""
}

# 托管安装的 deploy/rollback.sh：$SRC_DIR，其次 /root/lecture-live；打印解析软链后的真实路径。
# 找到的脚本会以 root 执行，所以刻意不去 /home/*/lecture-live 里找（任何本地用户都能在自己家目录下
# 放一个 lecture-live/deploy/rollback.sh），调用方还要用 require_root_only 确认它所在的 deploy/
# 只有 root 能改。源码放在家目录里的手工部署直接运行该检出里的 rollback.sh。
find_rollback_script() {
    local dir
    for dir in "$SRC_DIR" /root/lecture-live; do
        if [[ -f "$dir/deploy/rollback.sh" ]]; then
            readlink -f "$dir/deploy/rollback.sh"
            return 0
        fi
    done
    return 1
}

cmd_rollback() {
    need_root rollback

    echo ""
    echo -e "${BOLD}  LectureLive 回滚${NC}"
    divider

    # 回滚逻辑只维护一份：deploy/rollback.sh。它按同一时间戳成对退回 systemd unit 与产物
    # （早于 health-ready-v1 的备份只有靠这一点才有退路）、启动前跑支付预检、按被恢复
    # 运行时的 marker 选 readiness 探测。这里只负责选备份再交给它，不另写兜底：旧写法调用
    # 一个从未存在过的 rollback-wrapper.sh，于是每次都落到一段内联脚本上，而那段脚本一律
    # 拒绝旧备份、也不退回 unit，早已和 rollback.sh 分叉。
    #
    # 从源码检出直接运行本脚本（sudo bash deploy/lecture-live rollback）时用同一个 deploy/ 里的
    # rollback.sh：以 root 跑的本来就是这个检出里的代码，不另查。否则用托管检出里的那份，它所在的
    # deploy/ 连同路径上每一级目录都必须只有 root 能改。
    local rollback_script here
    here="$(dirname "$(readlink -f "$0")")"
    if [[ "$(basename "$here")" == deploy && -f "$here/rollback.sh" ]]; then
        rollback_script="$here/rollback.sh"
    else
        rollback_script="$(find_rollback_script)" \
            || fatal "未找到 deploy/rollback.sh（托管安装应位于 $SRC_DIR/deploy/）；未做任何改动。手工部署请在源码目录执行: sudo bash deploy/rollback.sh"
        require_root_only "$(dirname "$rollback_script")" "rollback 要以 root 执行 $rollback_script"
    fi

    # 列出可用备份
    if [[ ! -d "$BACKUP_DIR" ]] || ! ls "$BACKUP_DIR"/app-*.tar.gz &>/dev/null; then
        fatal "没有可用的备份文件"
    fi
    # 备份会以 root 解包（systemd-*.tar.gz 更是解进 /etc/systemd/system）：选之前先确认只有 root 能改，
    # 而且里面只有普通文件——root 名下的软链照样能指到服务用户放在别处的归档。rollback.sh 自己还会再核对一次。
    local backup_dir odd
    backup_dir="$(readlink -f "$BACKUP_DIR")"
    require_root_only "$backup_dir" "rollback 要以 root 解包 $BACKUP_DIR 里的备份"
    odd="$(find "$backup_dir" -mindepth 1 \( ! -type f -o -links +1 \) -print -quit)"
    [[ -z "$odd" ]] || fatal "$BACKUP_DIR 里只应有 root 打的备份文件，不能有软链、子目录或多重硬链接: ${odd}；未做任何改动"

    echo "  可用备份:"
    echo ""
    local i=1
    local -a backups=()
    while IFS= read -r f; do
        backups+=("$f")
        local fname size
        fname=$(basename "$f")
        size=$(du -h "$f" | cut -f1)
        # 从文件名中提取时间
        local ts
        ts=$(echo "$fname" | sed 's/app-\([0-9]*\)_\([0-9]*\).*/\1 \2/' | sed 's/\(....\)\(..\)\(..\) \(..\)\(..\)\(..\)/\1-\2-\3 \4:\5:\6/')
        printf "    ${CYAN}%d${NC}) %s  (%s)  %s\n" "$i" "$fname" "$size" "$ts"
        ((i++))
    done < <(ls -t "$BACKUP_DIR"/app-*.tar.gz)

    echo ""
    read -rp "  选择备份编号 [1]: " choice
    choice=${choice:-1}

    if [[ $choice -lt 1 || $choice -gt ${#backups[@]} ]]; then
        fatal "无效的选择"
    fi

    local selected="${backups[$((choice-1))]}"
    echo ""
    # rollback.sh 只接受 $BACKUP_DIR 下的文件名；确认、停服与失败隔离都由它负责
    bash "$rollback_script" "$(basename "$selected")"
}

cmd_env() {
    local env_file="$APP_DIR/.env"
    if [[ ! -f "$env_file" ]]; then
        fatal ".env 文件不存在: $env_file"
    fi

    if [[ "${1:-}" == "edit" ]]; then
        need_root "env edit"
        ${EDITOR:-nano} "$env_file"
        echo ""
        warn "修改 .env 后需要重启服务才能生效"
        read -rp "  立即重启? [y/N] " confirm
        [[ "$confirm" =~ ^[yY]$ ]] && cmd_restart
    else
        echo ""
        echo -e "${BOLD}  环境配置${NC} ${DIM}($env_file)${NC}"
        divider
        # 脱敏显示
        while IFS= read -r line; do
            # 跳过空行和注释
            [[ -z "$line" || "$line" =~ ^# ]] && echo "  $line" && continue
            # 对值做脱敏
            local key val
            key="${line%%=*}"
            val="${line#*=}"
            # 敏感字段脱敏
            if echo "$key" | grep -qiE '(password|secret|key|token)'; then
                echo -e "  ${key}=${DIM}********${NC}"
            else
                echo "  $line"
            fi
        done < "$env_file"
        divider
        echo -e "  ${DIM}提示: lecture-live env edit 可编辑配置${NC}"
        echo ""
    fi
}

cmd_self_install() {
    need_root "self-install"
    local script_path
    script_path="$(readlink -f "$0")"
    _install_self "$(dirname "$(dirname "$script_path")")"
}

_install_self() {
    local src_dir="${1:-}"
    local target="/usr/local/bin/lecture-live"
    local script_src

    # 优先从源码 deploy 目录复制（install 传入已查过的 $SRC_DIR，self-install 传入本脚本所在的检出）
    if [[ -n "$src_dir" && -f "$src_dir/deploy/lecture-live" ]]; then
        script_src="$src_dir/deploy/lecture-live"
    elif [[ -f "$APP_DIR/src/deploy/lecture-live" ]]; then
        # 装进去的这份此后每次都以 root 运行：托管检出里的也得只有 root 能改
        script_src="$(readlink -f "$APP_DIR/src/deploy/lecture-live")"
        require_root_only "$(dirname "$script_src")" "要把 $script_src 装成以 root 运行的管理命令"
    else
        # 如果找不到源文件，就复制自身
        script_src="$(readlink -f "$0")"
    fi

    cp "$script_src" "$target"
    chmod +x "$target"
    info "管理命令已安装到 $target"
}

