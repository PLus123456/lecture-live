}

interactive_log_menu() {
    echo ""
    echo -e "  查看哪个服务的日志?"
    echo -e "    ${CYAN}1${NC}) 全部       ${CYAN}2${NC}) Web       ${CYAN}3${NC}) WebSocket"
    echo ""
    read -rp "  请选择 [1]: " log_choice
    log_choice=${log_choice:-1}
    case "$log_choice" in
        1) cmd_log ;;
        2) cmd_log web ;;
        3) cmd_log ws ;;
        *) warn "无效选择" ;;
    esac
}

interactive_log_follow() {
    echo ""
    echo -e "  实时跟踪哪个服务?"
    echo -e "    ${CYAN}1${NC}) 全部       ${CYAN}2${NC}) Web       ${CYAN}3${NC}) WebSocket"
    echo ""
    read -rp "  请选择 [1]: " log_choice
    log_choice=${log_choice:-1}
    case "$log_choice" in
        1) cmd_log -f ;;
        2) cmd_log web -f ;;
        3) cmd_log ws -f ;;
        *) warn "无效选择" ;;
    esac
}

run_interactive() {
    while true; do
        show_menu
        read -rp "  请输入编号: " choice
        echo ""
        case "$choice" in
            1)  cmd_start ;;
            2)  cmd_stop ;;
            3)  cmd_restart ;;
            4)  cmd_status ;;
            5)  cmd_update ;;
            6)  cmd_rollback ;;
            7)  cmd_install ;;
            8)  cmd_uninstall ;;
            9)  interactive_log_menu ;;
            10) interactive_log_follow ;;
            11) cmd_env ;;
            12) cmd_env edit ;;
            0|q|Q|exit) echo "  再见！"; exit 0 ;;
            *)  warn "无效选择，请重试" ;;
        esac
        echo ""
        read -rp "  按 Enter 返回菜单..." _
    done
}

