# ══════════════════════════════════════════
#  入口
# ══════════════════════════════════════════

main() {
    # 无参数：交互式菜单
    if [[ $# -eq 0 ]]; then
        run_interactive
        return
    fi

    local cmd="$1"
    shift

    case "$cmd" in
        start)        cmd_start "$@" ;;
        stop)         cmd_stop "$@" ;;
        restart)      cmd_restart "$@" ;;
        status)       cmd_status "$@" ;;
        log|logs)     cmd_log "$@" ;;
        update|upgrade) cmd_update "$@" ;;
        install)      cmd_install "$@" ;;
        uninstall)    cmd_uninstall "$@" ;;
        rollback)     cmd_rollback "$@" ;;
        env)          cmd_env "$@" ;;
        self-install) cmd_self_install "$@" ;;
        help|-h|--help) show_help ;;
        version|-v|--version) echo "lecture-live v${VERSION}" ;;
        *)
            error "未知命令: $cmd"
            echo "  运行 lecture-live help 查看可用命令"
            exit 1
            ;;
    esac
}

main "$@"
