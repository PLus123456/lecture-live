[Unit]
Description=LectureLive Next.js Web Server
After=network.target mysql.service redis.service lecturelive-ws.service
Wants=mysql.service redis.service
# Web 与 WebSocket 必须作为一个故障域启动/停止。这样直接 systemctl start 任一 unit
# 也会拉起另一项；任一项退出或启动闸失败时，另一项随即被停掉。
BindsTo=lecturelive-ws.service

[Service]
Type=simple
User=lecturelive
Group=lecturelive
WorkingDirectory=/opt/lecturelive
# 只监听回环。Next standalone 的 server.js 取 `process.env.HOSTNAME || '0.0.0.0'`，
# 不设就是全网卡监听 —— 公网 IP 主机上直连 :3000 即绕开 nginx 的 client_max_body_size、
# 超时与将来任何在 nginx 层加的限流（P6-1）。nginx 与本服务同机，回环足够。
# 注意：这两行必须排在 ExecStart 之前才对该进程生效。
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
# 使用 node --env-file 加载 .env（正确处理引号），不用 EnvironmentFile
# 每次启动都重新验证持久化的生产支付配置；不能只依赖安装/升级时的一次检查，
# 否则运维之后直接 systemctl restart 会绕过 SEC-024 的 fail-closed 边界。
ExecStartPre=/usr/bin/grep -Fxq health-ready-v1 /opt/lecturelive/.runtime-security-version
ExecStartPre=/usr/bin/node --env-file=/opt/lecturelive/.env /opt/lecturelive/scripts/check-production-payment-config.mjs
ExecStart=/usr/bin/node --env-file=/opt/lecturelive/.env server.js
# 等 Web 真正可连接并完成受保护的深度检查。旧备份没有 readiness 路由，且在上面的
# runtime marker 处就会被拒绝，不能在回滚/直接 systemctl start 时短暂重新上线匿名深探测。
ExecStartPost=/usr/bin/node --env-file=/opt/lecturelive/.env /opt/lecturelive/scripts/check-readiness.mjs --wait
# 不在 unit 内自动重试启动安全闸。否则 marker/payment/readiness 的确定性失败会被
# Restart=always 放大成无限重启；恢复配置后由运维显式重新启动两项服务。
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lecturelive-web

# 安全加固
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
# 整个文件系统只读，仅放开应用真正需要写的目录：
#   data/        —— 录音、转录、摘要、图标、异步上传分片等运行时产物
#   .next/cache/ —— Next.js standalone 运行时缓存（ISR / fetch cache / 图片优化）
ProtectSystem=strict
ReadWritePaths=/opt/lecturelive/data /opt/lecturelive/.next/cache
# 丢弃全部 capability（监听 3000，非特权端口，无需 CAP_NET_BIND_SERVICE）
CapabilityBoundingSet=
# 仅保留出网 / 本地 socket（Prisma、Redis、HTTP 出站均够用）
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 收紧内核 / 进程面
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# 注：不设 MemoryDenyWriteExecute —— Node/V8 的 JIT 需要可写可执行内存，开了会直接崩。

[Install]
WantedBy=multi-user.target
