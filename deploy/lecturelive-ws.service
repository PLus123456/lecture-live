[Unit]
Description=LectureLive WebSocket Server
After=network.target mysql.service redis.service
Wants=mysql.service redis.service
# 与 Web 双向绑定：直接启动任一 unit 都会纳入完整 Web+WS 启动事务，任一项
# 退出或启动闸失败时另一项也会停止，避免只剩半套服务继续对外提供能力。
BindsTo=lecturelive-web.service

[Service]
Type=simple
User=lecturelive
Group=lecturelive
WorkingDirectory=/opt/lecturelive/ws-server
# P6-1：与 web 一样把监听地址收敛到回环 —— nginx 与本进程同机，3001 无需对外可见。
# （websocket.js 默认仍是 0.0.0.0，因为容器部署里 Docker 转发连的是容器 IP 而非容器内 loopback。）
# 必须排在 ExecStart 之前：node --env-file 不会覆盖已存在的进程环境变量。
Environment=WS_HOST=127.0.0.1
# 使用 node --env-file 加载 .env（正确处理引号），不用 EnvironmentFile
# websocket.js 是 esbuild 编译的产物，不再依赖 ts-node
ExecStartPre=/usr/bin/grep -Fxq health-ready-v1 /opt/lecturelive/.runtime-security-version
ExecStartPre=/usr/bin/node --env-file=/opt/lecturelive/.env /opt/lecturelive/scripts/check-production-payment-config.mjs
ExecStart=/usr/bin/node --env-file=/opt/lecturelive/.env websocket.js
# 启动安全闸失败必须保持停止，不能由 Restart=always 无限重试。
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lecturelive-ws

# 安全加固
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
# 整个文件系统只读，仅放开应用真正需要写的目录。ws-server 的 data 是指向
# /opt/lecturelive/data 的软链（liveShare 把直播转录落到 data/transcripts），
# systemd 会解析软链到真实路径，故这里直接列真实目录。
ProtectSystem=strict
ReadWritePaths=/opt/lecturelive/data
# 丢弃全部 capability（监听 3001，非特权端口，无需 CAP_NET_BIND_SERVICE）
CapabilityBoundingSet=
# 仅保留出网 / 本地 socket（Socket.IO、Prisma、Redis 均够用）
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 收紧内核 / 进程面
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# 注：不设 MemoryDenyWriteExecute —— Node/V8 的 JIT 需要可写可执行内存，开了会直接崩。

[Install]
WantedBy=multi-user.target
